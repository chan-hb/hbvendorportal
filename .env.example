# ---------- Database ----------
# Azure Database for PostgreSQL Flexible Server:
#   postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/DB?sslmode=require
# Neon, Supabase and Vercel Postgres all work too. SSL is required either way.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ---------- Auth.js ----------
AUTH_SECRET="run: openssl rand -base64 32"
# The public URL of the site. Used in links inside emails, so it has to be
# right or password reset links point at the wrong place.
AUTH_URL="https://your-app.azurewebsites.net"
AUTH_TRUST_HOST="true"

# ---------- Outbound email ----------
# Microsoft Graph is used when these three are present. Mail is then sent from a
# real mailbox in the Huda Beauty tenant and copied to its Sent Items.
# Needs an app registration with the Mail.Send APPLICATION permission and admin
# consent. Scope it to one mailbox with an Exchange application access policy,
# or the registration can send as anyone in the company.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# The mailbox to send from, used when no sender has been chosen in the app.
GRAPH_SENDER="sourcing@hudabeauty.com"

# Resend, only as a fallback for a deployment outside the Microsoft tenant.
# Leave blank when using Graph.
AUTH_RESEND_KEY=""
EMAIL_FROM=""

# Microsoft Entra SSO for Huda Beauty staff (optional but recommended)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# ---------- Access control ----------
# Any email on these domains is treated as internal Huda Beauty staff
HB_DOMAINS="hudabeauty.com"
# Comma separated. These accounts are bootstrapped as HB_ADMIN on first login.
HB_ADMIN_EMAILS="ryan@hudabeauty.com"

# ---------- Encryption for stored D365 secrets ----------
# 32 bytes, base64. openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ---------- Cron ----------
CRON_SECRET="random-long-string"

# ---------- Sourcing assistant (optional) ----------
# Without a key the assistant still works, using keyword routing and plain
# summaries. With one it understands free-form questions and phrases answers.
# It never sees the database: it picks a query and summarises the rows returned.
ANTHROPIC_API_KEY=""
COPILOT_MODEL="claude-sonnet-4-6"

# ---------- Hosting ----------
# App Service listens on the port it injects. Leave unset locally.
# PORT=8080

# Set to true to stop the startup script applying the Prisma schema, for
# example if a DBA applies schema changes by hand.
# SKIP_DB_PUSH="false"
